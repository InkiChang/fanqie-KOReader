# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.lua]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf
