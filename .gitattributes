# 统一换行符：仓库内一律 LF，Windows 检出也保持 LF
* text=auto eol=lf

# 显式声明文本类型，避免被误判为二进制
*.lua   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
Makefile text eol=lf

# 二进制资源不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.zip   binary
*.xz    binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary

# 语言统计：把插件源码算作 Lua，把标记语言排除
docs/**        linguist-documentation
refs/**        linguist-vendored
tests/**       linguist-detectable=false
*.koplugin/**  linguist-vendored=false

# 历史版本的 CHANGELOG 会在合并时冲突，交给脚本处理
CHANGELOG.md merge=union
